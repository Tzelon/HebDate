<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top|start"
    android:layoutDirection="rtl"
    android:padding="18dp"
    android:background="@drawable/widget_card">

    <TextView android:id="@+id/day"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/widget_text" android:textSize="20sp"
        android:fontFamily="@font/hebdot" android:maxLines="1" />

    <TextView android:id="@+id/year"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/widget_text" android:textSize="16sp"
        android:fontFamily="@font/hebdot" android:maxLines="1" />

    <TextView android:id="@+id/parsha"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/widget_text" android:textSize="16sp"
        android:fontFamily="@font/hebdot" android:maxLines="1" />

    <TextView android:id="@+id/shabbat"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/widget_text_dim" android:textSize="16sp"
        android:fontFamily="@font/hebdot" android:maxLines="1" android:visibility="gone" />
</LinearLayout>
